# Copy to .env.local and fill in. Never commit real keys or paste them into chat.

# --- Live mode on Sepolia. The Safe and names are chosen at /setup (not here); until then the app runs the demo. ---
SAFE_API_KEY=
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Force the demo even with a Safe set up:
# NEXT_PUBLIC_SECOND_LOOK_MODE=demo

# --- Guardian's Ledger. Default: Speculos emulator, reached by the server (lib/ledger.ts). ---
SPECULOS_PORT=5001
# Real Ledger in Chrome/Edge instead (browser signs over WebHID):
# NEXT_PUBLIC_LEDGER_TRANSPORT=webhid
SPECULOS_URL=http://127.0.0.1:5001

# --- Lumi (AI agent). Empty = scripted questions, no AI. ---
ANTHROPIC_API_KEY=
LUMI_MODEL=claude-sonnet-5-5

# Fallback daily limit (USDC) before the on-chain allowance is turned on
DAILY_LIMIT_USDC=200
